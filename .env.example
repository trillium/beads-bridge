# Local-only. Copy to .env (gitignored) and fill in. Never commit .env.
FUNNEL_BASE=https://<your-funnel-host>
TAILNET_IP=100.x.x.x
# Usage analytics (PostHog). Optional — without POSTHOG_KEY tracking is a no-op.
# Find the key in PostHog project settings. EU-cloud projects set
# POSTHOG_HOST=https://eu.i.posthog.com instead.
POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# OAuth human approval is a tailnet-only QR: the public page shows a QR/link to
# http://$TAILNET_IP:$BEADS_BRIDGE_APPROVAL_PORT/oauth/approve/<id>, served on a
# second listener bound to TAILNET_IP. Needs TAILNET_IP (above) set to this host's
# 100.64.0.0/10 address. Port defaults to PORT+1.
# BEADS_BRIDGE_APPROVAL_PORT=3738
# Local data paths (all optional, defaults shown). Files stay out of the repo.
# FEEDBACK_DIR=~/data/feedback
# SCRATCHPAD_PATH=~/data/scratchpad.md
# IDENTITY_PATH=~/.config/beads-bridge/beads-bridge-identity.json
# OAUTH_STORE_PATH=~/.config/beads-bridge/beads-bridge-oauth.json
# Failing /mcp payload diagnosis (content-type + truncated body, never auth).
# Off unless set — leave off in normal operation.
# MCP_DEBUG=1
# SQL read door (src/lib/sql.ts). Defaults: 127.0.0.1:3307 root brain_unified.
# A bridge that is NOT on the Dolt host must point these at the authoritative
# server with a SELECT-only user (remote root is refused), otherwise lists/search
# read a stale local copy. Deploys never touch .env, so this persists.
# BEADS_BRIDGE_SQL_HOST=100.x.x.x
# BEADS_BRIDGE_SQL_PORT=3307
# BEADS_BRIDGE_SQL_USER=bridge_ro
# BEADS_BRIDGE_SQL_PASSWORD=
# BEADS_BRIDGE_SQL_DATABASE=brain_unified
