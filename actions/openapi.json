    },
    "/guide/refine": {
      "get": {
        "operationId": "guide_refine",
        "summary": "Guide: Refinement rubric: X-Y-Z, validity, AI-slop flags, grandma test.",
        "description": "Served verbatim from cv-generator (refine).",
        "responses": {
          "200": {
            "description": "Guide markdown",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/print/{resumeId}": {
      "get": {
        "operationId": "print_setup",
        "summary": "Print page setup + layout verdict for a resume.",
        "parameters": [
          {
            "name": "resumeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "resumes-zak"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Plain-text print setup",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/fetch/{resumeId}/findings": {
      "get": {
        "operationId": "fetch_resume_findings",
        "summary": "Open verification findings for a resume.",
        "parameters": [
          {
            "name": "resumeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "resumes-zak"
            }
          }
