      "get": {
        "operationId": "guide_bullets",
        "summary": "Guide: Bullet doctrine: Action-Number-Method, quantification, weak styles.",
        "description": "Served verbatim from cv-generator (bullets).",
        "responses": {
          "200": {
            "description": "Guide markdown",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/guide/questioning": {
      "get": {
        "operationId": "guide_questioning",
        "summary": "Guide: Clarifying-question workflow for extracting proof without fabricating.",
        "description": "Served verbatim from cv-generator (questioning).",
        "responses": {
