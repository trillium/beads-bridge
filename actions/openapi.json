  },
  "components": {
    "schemas": {
      "BeadBody": {
        "type": "object",
        "required": [
          "bead_id"
        ],
        "properties": {
          "bead_id": {
            "type": "string",
            "example": "review-fmt"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Optional; replays return the stored response"
          }
        }
      },
      "CommentBody": {
        "type": "object",
        "required": [
          "bead_id",
          "text"
        ],
        "properties": {
          "bead_id": {
            "type": "string",
            "example": "review-fmt"
          },
          "text": {
            "type": "string",
            "description": "Comment or note text"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Optional; replays return the stored response"
          }
        }
      },
      "Bead": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "bead_id": {
            "type": "string"
          },
          "store": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "priority": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comments": {
            "type": "string"
          },
          "available_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wrote": {
            "type": "string",
            "description": "Present on mutations"
          },
          "transitioned": {
            "type": "string",
            "description": "Present on approve/reject/done"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}